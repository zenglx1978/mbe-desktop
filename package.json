{
  "name": "mbe-desktop",
  "version": "0.2.0",
  "description": "MBE Desktop — AI 专业服务统一桌面端",
  "main": "dist/main/index.js",
  "author": "MBE Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"npm run dev\" \"npm run compile:main -- --watch\" \"wait-on http://localhost:5180 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .\"",
    "compile:main": "tsc -p tsconfig.main.json",
    "build": "vite build && npm run compile:main",
    "preview": "vite preview",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:dir": "npm run build && electron-builder --dir",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^3.3.1",
    "electron": "^28.2.0",
    "electron-builder": "^26.7.0",
    "lucide-react": "^0.323.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^9.0.3",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.himaker.mbe-desktop",
    "productName": "MBE Desktop",
    "copyright": "Copyright (c) 2026 MBE Team",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.claude/skills/finance-calc/scripts",
        "to": "calc-scripts",
        "filter": ["calc_*.py"]
      },
      {
        "from": "../.claude/skills/legal-calc/scripts",
        "to": "calc-scripts",
        "filter": ["calc_*.py"]
      },
      {
        "from": "../.claude/skills/cost-calc/scripts",
        "to": "calc-scripts",
        "filter": ["calc_*.py"]
      },
      {
        "from": "../.claude/skills/pulmonary-calc/scripts",
        "to": "calc-scripts",
        "filter": ["calc_*.py"]
      },
      {
        "from": "../mbe-hr-backend/scripts",
        "to": "calc-scripts",
        "filter": ["calc_*.py"]
      },
      {
        "from": "../mbe-finance-backend/scripts",
        "to": "calc-scripts",
        "filter": ["calc_stamp_tax.py"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MBE-Desktop-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "artifactName": "MBE-Desktop-${version}-macOS.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "artifactName": "MBE-Desktop-${version}-Linux.${ext}"
    },
    "protocols": [
      {
        "name": "MBE Desktop",
        "schemes": ["mbe-desktop"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MBE Desktop",
      "uninstallDisplayName": "MBE Desktop — AI 专业服务",
      "language": "2052",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MBE-Desktop-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mbe.hi-maker.com/downloads/desktop/",
        "useMultipleRangeRequest": false
      }
    ]
  }
}
